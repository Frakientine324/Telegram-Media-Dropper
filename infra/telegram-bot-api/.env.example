# Obtain these from https://my.telegram.org/apps. Keep this file private.
TELEGRAM_API_ID=replace-with-api-id
TELEGRAM_API_HASH=replace-with-api-hash

# Point a DNS A record for this name to the Linux server before starting Caddy.
TELEGRAM_API_DOMAIN=bot-api.example.com

# Protect the public API with Caddy basic authentication.
TELEGRAM_API_USERNAME=telegram-drop
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext
# Keep the generated hash single-quoted in this file.
TELEGRAM_API_PASSWORD_HASH='replace-with-caddy-password-hash'
